# 制作・検証スクリプト専用（ゲーム本体は使わない）。このファイルをコピーして値を入れても、
# スクリプトは .env を自動では読みません。PowerShell なら次のように環境変数として渡してください：
#   $env:GEMINI_API_KEY = "（キー）"            # または
#   $env:GEMINI_API_KEY_FILE = "..\GeminiAPI.txt" # キーを書いたファイルのパス
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
# 生成用とレビュー用のモデルは別々に設定できる（2026-10-18にモデル一覧で存在を確認）
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_REVIEW_MODEL=gemini-3.8-flash
